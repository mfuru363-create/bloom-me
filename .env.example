# Gemini API（https://aistudio.google.com/apikey で取得）
GEMINI_API_KEY=

# 任意（AI Studio エクスポート準拠）
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_QUALITY_MODEL=gemini-3-pro-image-preview

# コスト制御（コード内定数・環境変数不要）
